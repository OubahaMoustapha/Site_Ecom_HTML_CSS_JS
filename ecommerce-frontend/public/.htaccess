# Apache: serve the single-page app (dist/) and its assets.
# Requires mod_rewrite; mod_headers and mod_expires are used when available.

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Real files (assets, images, robots.txt) are served as-is.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Every other path is a client-side route: let React Router handle it.
    RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Hashed build files never change: cache them for a year. index.html must stay fresh.
    <FilesMatch "\.(js|css|woff2?|svg|png|jpe?g|webp)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "index\.html$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>
